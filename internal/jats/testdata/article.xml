<tr><td rowspan="1" colspan="1">Transfusion</td><td rowspan="1" colspan="1">14 (12)</td><td rowspan="1" colspan="1">37 (31)</td><td rowspan="1" colspan="1">0.39 (0.24&#8211;0.62)</td></tr>
