# Log verbosity (debug | info | warn | error) and format (text | json).
LOG_LEVEL=info
LOG_FORMAT=text

# Scite API (optional: free tier works without a key; key: scite.ai/users/me/api)
SCITE_API_KEY=

# Consensus API — semantic discovery, mode B (key: consensus.app → API & MCP
# dashboard, consensus.app/api-mcp). With a key set, `verdict run -q` discovers
# through Consensus automatically (~1 API use per results page; the Pro tier
# includes 500/mo). MCP auth is configured separately via `claude mcp add`.
CONSENSUS_API_KEY=

# Max Consensus search pages per discovery query (quota guard; default 3).
CONSENSUS_PAGES=3

# Semantic Scholar (optional key: raises the free anonymous rate limits — the
# pipeline makes one batched request per run anyway)
S2_API_KEY=

# PubPeer developer key (optional, issued on request at pubpeer.com) — enables
# the post-publication commentary check
PUBPEER_DEVKEY=

# OpenAlex asks for an e-mail to join the "polite pool" (optional but nice)
OPENALEX_EMAIL=

# ── LLM backend for analytical stages ──
# Empty (the default) is always claude-cli: the Claude Code subscription
# through a wrapper. anthropic and openai-compat are paid APIs and are used
# only when named here — a key in this file never switches a run to them.
LLM_BACKEND=

# claude-cli: which wrapper runs the calls. The order of resolution:
#   1. --llm-command of the run
#   2. CLAUDE_WRAPPER — exported by the wrapper of the agent session the run
#      is started from (a run from a session uses that session's account)
#   3. LLM_COMMAND below — for runs outside an agent session (a terminal,
#      verdictd); the session wins over this file on purpose
#   4. claude-max (the default) — set LLM_COMMAND only to use another one
# The command is always a wrapper (claude-max, claude-ds, ...), never the
# bare `claude`: the wrapper sets the account, the gateway and the proxy.
# WARNING: claude-zai is one-way — the first request blocks the corporate
# gateway for hours of cooldown. Corporate wrappers have no such effect.
LLM_COMMAND=

# Models are names or aliases: opus, sonnet, haiku, fable resolve in every
# wrapper (the GLM and DeepSeek wrappers map them to their own models).
# Empty = the role's default. Precedence per role: the role's CLI flag, then
# LLM_MODEL_<ROLE>, then --llm-model, then LLM_MODEL, then the default.
# LLM_MODEL sets one model for every role.
LLM_MODEL=

# Per-role models and their defaults (effort is passed to claude-max only):
#   plan       sonnet  low     questions from a messy description (brief, pico)
#   critique   opus    low     per-paper review of the abstracts
#   deep       opus    high    re-critique of the pivotal studies on full texts
#   synthesis  opus    high    the verdict (fable with `verdict run --deep`)
#   ask        sonnet  medium  questions about a finished run
LLM_MODEL_PLAN=
LLM_MODEL_CRITIQUE=
LLM_MODEL_DEEP=
LLM_MODEL_SYNTHESIS=
LLM_MODEL_ASK=

# Per-attempt LLM timeout as a Go duration: 90s, 10m, 1h30m (a bare number
# such as 600 is rejected). Synthesis over 15 papers can take a while.
LLM_TIMEOUT=10m

# ── Anthropic API (LLM_BACKEND=anthropic only) ──
# A personal paid key: calls go out only through an HTTPS proxy (the VPS),
# never directly from this machine. The key, the proxy and the model are all
# required; there is no default model and aliases do not work here.
ANTHROPIC_API_KEY=
# HTTPS CONNECT proxy URL, e.g. https://user:pass@vps.example.org:443
ANTHROPIC_PROXY=
# Exact API model id (see the Anthropic models list)
ANTHROPIC_MODEL=

# ── Any OpenAI-compatible endpoint (LLM_BACKEND=openai-compat only) ──
# OpenRouter / DeepSeek / vLLM / Together / OpenAI / Groq ...
# The model name for this backend goes in LLM_MODEL (or a LLM_MODEL_<ROLE>).
OPENAI_BASE_URL=
OPENAI_API_KEY=
# HTTPS CONNECT proxy URL, e.g. https://user:pass@vps.example.org:443.
# REQUIRED when the base URL is OpenAI or Groq (empty OPENAI_BASE_URL is
# OpenAI): personal paid keys never go out directly. Optional for other
# hosts; when set it is always used.
OPENAI_PROXY=

# How many papers to take from discovery
MAX_PAPERS=15
# Enrichment parallelism (OpenAlex etc.)
CONCURRENCY=4

# Per-topic DOI enrichment cache (OpenAlex/Crossref lookups), days; 0 disables.
# Challenge re-runs of the same topic reuse it instead of re-querying.
ENRICH_CACHE_TTL_DAYS=30

